{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lucka",
  "version": "0.3.0",
  "identifier": "dev.juanramirez.lucka",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/stage-native-libs.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Lucka",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERTZBOUVEOTFEODUwNTgKUldSWVVOaVI3YW5tVFR2VEQrQTZGemNBczJrUXlFTzlIOXlNMXZ6Qk1EWHY3amxZR015RTRHbEoK",
      "endpoints": [
        "https://github.com/juan-ramirez-dev/lucka/releases/latest/download/latest.json"
      ]
    }
  }
}
